# FinPilot AI Service environment

# ==============================================
# Required production variables
# ==============================================

# App environment: development | production
# In production the service refuses to start without AI_SERVICE_KEY plus the
# hosted LLM credentials below (LLM_API_KEY + LLM_MODEL).
APP_ENV=development

# Shared secret between the Node backend and this service.
# Required in production. The Node side must set AI_SERVICE_KEY to the same value.
AI_SERVICE_KEY=

# LLM provider: openai (default, any OpenAI-compatible /chat/completions API)
#               ollama (LOCAL DEVELOPMENT ONLY)
AI_PROVIDER=openai

# Hosted LLM provider credentials. SECRET — lives only in this service.
# Never expose through the frontend or the Node backend.
LLM_API_KEY=

# Model name supplied by deployment configuration (e.g. gpt-4o-mini, claude ...).
LLM_MODEL=

# Optional: OpenAI-compatible base URL. Defaults to https://api.openai.com/v1.
# Use this for other hosted providers (OpenRouter, Together, Groq, Azure-compatible, ...).
LLM_BASE_URL=https://api.openai.com/v1

# Hosted LLM tuning (optional)
LLM_TIMEOUT=25
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500

# ==============================================
# LOCAL DEVELOPMENT ONLY — never required in production
# ==============================================

# Ollama (local model) is supported ONLY as an optional development provider.
# It is used only when AI_PROVIDER=ollama. Not required for any production
# deployment, and never allowed in production with a localhost endpoint.
# OLLAMA_BASE_URL is an accepted alias and takes precedence over OLLAMA_URL.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=30
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=500

# ==============================================
# OCR / uploads (optional)
# ==============================================

OCR_LANG=en
OCR_GPU=false
MAX_UPLOAD_SIZE=10485760

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Server port
PORT=8000