# ============================================
# FinPilot AI — Backend Environment
# ============================================
# Copy this file to `.env` and fill in real values.
# In production, missing or weak secrets cause the server to refuse to start.

# App
NODE_ENV=development
PORT=5000

# MongoDB (MongoDB Atlas URI required for production)
MONGODB_URI=mongodb://localhost:27017/finpilot

# JWT — REQUIRED. Values below are development-only placeholders and are
# REJECTED in production (they are in the weak-secret list). Generate strong
# unique secrets, e.g.: openssl rand -hex 64
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Redis — optional. When set, rate limits and the login cooldown are shared
# across serverless instances (Upstash, Redis Cloud, or a self-host).

# Production recommended. Leave empty to fall back to per-instance in-memory
# state (works, but not distributed across Vercel functions).
REDIS_URL=

# CORS — comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Cookies
# sameSite: lax (local dev) | none (cross-site deployments, requires secure)
# secure:  set true when serving over HTTPS (auto-enables in production)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# AI Service (FastAPI) — never localhost in production
# AI_SERVICE_KEY must match the value set in the AI service (required in prod)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=

# File uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Receipt storage — S3-compatible object storage (AWS S3, Cloudflare R2, MinIO)
# provider: local (dev) | s3
# In production with provider=s3 all RECEIPT_STORAGE_* values are required.
RECEIPT_STORAGE_PROVIDER=local
RECEIPT_STORAGE_BUCKET=
RECEIPT_STORAGE_REGION=auto
RECEIPT_STORAGE_ENDPOINT=
RECEIPT_STORAGE_ACCESS_KEY_ID=
RECEIPT_STORAGE_SECRET_ACCESS_KEY=
RECEIPT_STORAGE_PUBLIC_BASE_URL=
RECEIPT_STORAGE_CDN_HOST=

# Rate limiting (per-instance, in-memory — not shared across serverless
# instances; scale with Redis for multi-replica production deployments)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=60
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=20

# Login cooldown (per-account progressive lockout)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_INITIAL_LOCKOUT_SECONDS=30
AUTH_MAX_LOCKOUT_SECONDS=300

# Admin seed (used by `npm run seed:admin` only — never committed)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Tests — set to a dedicated database; do NOT share the dev/prod DB
TEST_MONGODB_URI=mongodb://localhost:27017/finpilot_test