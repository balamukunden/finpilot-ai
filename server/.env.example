# ============================================
# FinPilot AI — Server Environment Variables
# ============================================

# App
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/finpilot

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# AI Service
AI_SERVICE_URL=http://localhost:8000

# File Uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Currency
DEFAULT_CURRENCY=INR

# ============================================
# Auth (progressive login cooldown)
# ============================================
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_INITIAL_LOCKOUT_SECONDS=30
AUTH_MAX_LOCKOUT_SECONDS=300

# ============================================
# Admin / Demo account (seeded server-side)
# ============================================
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_RESET_PASSWORD=0
