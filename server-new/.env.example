# ============================================
# FinPilot AI — New Backend Environment
# ============================================

# App
NODE_ENV=development
PORT=5000

# MongoDB (MongoDB Atlas URI required for production)
MONGODB_URI=mongodb://localhost:27017/finpilot

# JWT (required — never commit real secrets)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# AI Service (FastAPI) — never localhost in production
AI_SERVICE_URL=http://localhost:8000

# File uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=60

# Login cooldown (per-account progressive lockout)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_INITIAL_LOCKOUT_SECONDS=30
AUTH_MAX_LOCKOUT_SECONDS=300

# Admin seed (used by `npm run seed:admin` only — never committed)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Tests — set to a dedicated database; do NOT share the dev/prod DB
TEST_MONGODB_URI=mongodb://localhost:27017/finpilot_test