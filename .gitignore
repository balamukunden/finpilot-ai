.env
.env.local
.env.development
.env.production
!.env.example

# Logs
*.log
logs/

# Coverage
coverage/

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Uploads & data
uploads/
.data/

# Local Node.js installation
.nodejs/

# OS files
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Agents / AI tooling local state
.agents/
.vercel
.env*
