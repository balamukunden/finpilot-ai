# FinPilot AI — Frontend Environment
# Copy to `.env` or `.env.local`.
#
# API base URL. Leave empty to use the same origin (`/api`) — works in the
# Vite dev proxy and when the frontend and backend share a deployment origin.
# When the backend is on a separate domain (e.g. separate Vercel projects),
# set this to the backend URL, e.g. https://your-api.vercel.app
VITE_API_URL=